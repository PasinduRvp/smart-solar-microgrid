<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SolarMicrogrid.Api</RootNamespace>

    <!-- Emit the XML documentation file so Swagger can render the /// comments
         written on controllers and DTOs as the live API contract. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- CS1591 warns about any public member without an XML comment. Our own
         code is documented; this suppression keeps generated and framework
         members from flooding the build output. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Treat warnings as errors so code smells such as unused variables or
         unreachable code cannot be silently committed. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
