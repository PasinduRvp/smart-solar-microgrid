<!--
  =========================================================================
  File        : activity_scan_result.xml
  Project     : Smart Solar Microgrid Trading System - SE4040 Assignment 1
  Author      : NIMSARA R V P P (IT 23215306)
  Created     : 2026-09-20
  Description : What the Grid Operator sees after scanning a QR code.
                Tasks E4 and E5.

  Order       Verified first, in green. Then who the prosumer is, then what
               the booking is for. The operator is standing at the node with
               a person in front of them, so the first thing they need is
               whether the code is good.

  Two buttons at the bottom
               Mark transfer complete finishes the booking. Scan another
               goes straight back to the camera, because an operator handles
               one prosumer after another.
  =========================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.operator.ScanResultActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/scan_result_title"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:id="@+id/tvVerified"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_verified"
                android:textAppearance="@style/TextAppearance.Solar.Title"
                android:textColor="@color/status_success" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_prosumer"
                        android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

                    <TextView
                        android:id="@+id/tvProsumer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textStyle="bold"
                        tools:text="Kamal Perera" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/summary_label_number"
                        android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

                    <TextView
                        android:id="@+id/tvNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="RES-000123" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/summary_label_node"
                        android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

                    <TextView
                        android:id="@+id/tvNode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="Galle Fort Solar Node" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/summary_label_when"
                        android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

                    <TextView
                        android:id="@+id/tvWhen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="25 Sep 2026, 8:00 AM" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/summary_label_energy"
                        android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

                    <TextView
                        android:id="@+id/tvEnergy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="12 kWh, Deliver to grid" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/summary_label_status"
                        android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textStyle="bold"
                        tools:text="Approved" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnComplete"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/screen_gutter"
        android:layout_marginEnd="@dimen/screen_gutter"
        android:text="@string/action_complete_transfer"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanAnother"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/screen_gutter"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_gutter"
        android:layout_marginBottom="@dimen/space_lg"
        android:text="@string/action_scan_another" />

</LinearLayout>
