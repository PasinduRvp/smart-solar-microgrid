<!--
  =========================================================================
  File        : activity_login.xml
  Project     : Smart Solar Microgrid Trading System - SE4040 Assignment 1
  Author      : <Your Full Name> (<IT Number>)
  Created     : 2026-09-20
  Description : The sign in screen.

  Alignment    Everything starts at the same left edge. The brand mark,
                the heading, the boxes and the button all line up on
                @dimen/screen_gutter. One shared edge is what makes a form
                look planned instead of thrown together.

                All the gaps come from @dimen. So they are multiples of
                8dp and match the other screens exactly.

  Why a ScrollView
                The keyboard covers about half the screen. On a short
                phone the Sign in button would sit under it and could not
                be tapped. A ScrollView lets the content move out of the
                way.

  One box for email or NIC
                The API takes either one in the same identifier field.
                So the screen asks once. The user does not have to choose
                which kind of identifier they are about to type.
  =========================================================================
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.auth.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/space_xl">

        <!-- Brand mark: a filled circle with the sun icon centred inside. -->
        <FrameLayout
            android:layout_width="@dimen/brand_mark_size"
            android:layout_height="@dimen/brand_mark_size"
            android:background="@drawable/bg_circle_primary_container">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_solar_24" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/login_title"
            android:textAppearance="@style/TextAppearance.Solar.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/login_subtitle"
            android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIdentifier"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:hint="@string/login_identifier_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIdentifier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!--
          passwordToggleEnabled gives the eye icon.
          Without it, a user who mistypes a long password on a phone keyboard
          cannot check it. They just try again blindly.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/field_gap"
            android:hint="@string/login_password_hint"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignIn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/action_sign_in"
            android:textStyle="bold" />

        <!--
          Sits under the button. It is shown while the call runs.
          The user can then see something is happening, instead of tapping
          Sign in a second time.
        -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoToRegister"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/login_no_account" />

    </LinearLayout>

</ScrollView>
