<?xml version="1.0" encoding="utf-8"?>
<!--
  =========================================================================
  File        : activity_transfer_summary.xml
  Project     : Smart Solar Microgrid Trading System - SE4040 Assignment 1
  Author      : NIMSARA R V P P (IT 23215306)
  Created     : 2026-09-21
  Description : Shown after the operator marks a transfer complete. Task E5.

  Why a page and not a toast
               The operator is standing at the node with a person in front
               of them. They need to see plainly that it worked, and be able
               to read the booking number back to the prosumer.
               A toast is gone in two seconds and cannot be read again.

               It also matches the booking summary the prosumer sees after
               every action, so both sides of the app behave the same way.

  Two ways out
               Scan another goes straight back to the camera, because an
               operator serves one prosumer after another.
               Done returns to the operator home screen.
  =========================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.operator.TransferSummaryActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        app:contentInsetStart="0dp"
        app:title="@string/transfer_title"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transfer_headline"
                android:textAppearance="@style/TextAppearance.Solar.Title"
                android:textColor="@color/status_success" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/transfer_note"
                android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_prosumer"
                        android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

                    <TextView
                        android:id="@+id/tvProsumer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textStyle="bold"
                        tools:text="Kamal Perera" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/summary_label_number"
                        android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

                    <TextView
                        android:id="@+id/tvNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="RSV-20260920-F0FC" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/summary_label_node"
                        android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

                    <TextView
                        android:id="@+id/tvNode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="Colombo Fort Microgrid Hub" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/summary_label_energy"
                        android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

                    <TextView
                        android:id="@+id/tvEnergy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        tools:text="12 kWh, Deliver to grid" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/summary_label_status"
                        android:textAppearance="@style/TextAppearance.Solar.Subtitle" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/status_success"
                        android:textStyle="bold"
                        tools:text="Completed" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanAnother"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/screen_gutter"
        android:layout_marginEnd="@dimen/screen_gutter"
        android:text="@string/action_scan_another"
        android:textStyle="bold"
        app:icon="@drawable/ic_qr_24"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDone"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/screen_gutter"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/screen_gutter"
        android:layout_marginBottom="@dimen/space_lg"
        android:text="@string/action_back_to_home" />

</LinearLayout>
