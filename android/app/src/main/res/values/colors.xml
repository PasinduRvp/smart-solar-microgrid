  Description : The colours, named by what they are for.

  A name like solar_amber says what the colour is for. Changing the shade
  later is then one edit here, not a search for #D97706 in every layout.

  Amber is for solar power. Teal is for the grid. The rest are neutrals
  for text and backgrounds.
  =========================================================================
-->
<resources>

    <!-- Brand -->
    <color name="solar_amber">#D97706</color>
    <color name="solar_amber_dark">#B45309</color>
    <color name="solar_amber_light">#FEF3C7</color>
    <color name="grid_teal">#0F766E</color>
    <color name="grid_teal_light">#CCFBF1</color>

    <!-- Neutrals -->
    <color name="ink">#111827</color>
    <color name="ink_muted">#6B7280</color>
    <color name="surface">#FFFFFF</color>
    <!-- Cards sit on this. Slightly off the page colour, so a card has an
         edge even before its outline is drawn. -->
    <color name="surface_container">#F5F3EF</color>
    <color name="hairline">#E5E7EB</color>

    <!-- Dark theme neutrals -->
    <color name="ink_dark">#F9FAFB</color>
    <color name="ink_muted_dark">#9CA3AF</color>
    <color name="surface_dark">#111827</color>
    <color name="surface_container_dark">#1B2332</color>

    <!-- Status: reserved, never reused for decoration -->
    <color name="status_success">#16A34A</color>
    <color name="status_warning">#CA8A04</color>
    <color name="status_danger">#DC2626</color>

    <color name="white">#FFFFFFFF</color>

</resources>
