  File        : values/themes.xml  (light)
  Project     : Smart Solar Microgrid Trading System - SE4040 Assignment 1
  Author      : NIMSARA R V P P (IT 23215306)
  Created     : 2026-09-20
  Description : The light theme.

  The colours are set on the theme, not on each widget. So a button added
  later is the right colour by itself. And the whole app can be restyled
  from this one file.
  =========================================================================
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.SolarMicrogrid" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/solar_amber</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/solar_amber_light</item>
        <item name="colorOnPrimaryContainer">@color/solar_amber_dark</item>

        <item name="colorSecondary">@color/grid_teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/grid_teal_light</item>
        <item name="colorOnSecondaryContainer">@color/grid_teal</item>

        <item name="colorError">@color/status_danger</item>

        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_muted</item>
        <item name="colorOutline">@color/hairline</item>

        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Every MaterialCardView picks this up, so the look is set once. -->
        <item name="materialCardViewStyle">@style/Widget.Solar.Card</item>
    </style>

    <style name="Theme.SolarMicrogrid" parent="Base.Theme.SolarMicrogrid" />

    <!-- ===== Reusable text styles ======================================= -->

    <!--
      ?attr/colorOnSurface rather than @color/ink, deliberately. A fixed colour
      here would stay dark in dark mode and become unreadable; the attribute
      resolves to whichever value the active theme defines.
    -->
    <!--
      The card used everywhere in the app.

      Setting it as materialCardViewStyle in the theme means a card added
      later looks right without anyone remembering four attributes. The
      background is the raised surface, so a card is visible as a panel and
      not only as a thin outline.
    -->
    <style name="Widget.Solar.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TextAppearance.Solar.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Solar.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>
